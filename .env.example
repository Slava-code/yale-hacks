# GX10 ASUS Ascent Connection
GX10_HOST=
GX10_USER=
GX10_PASSWORD=

# Cloud AI API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local gatekeeper (Ollama) — optional, defaults shown
# OLLAMA_URL=http://localhost:11434
# GATEKEEPER_MODEL=qwen2.5:32b

# Data paths — optional. Both default to the repo root, resolved from the
# backend package location, so the server can be started from any directory.
# Relative values are resolved against the repo root.
# GRAPH_PATH=data/graph.json
# PDF_DIR=data/pdfs

# YHack theme-prize demo mode (easter eggs) — off by default
# DEMO_EASTER_EGGS=1
